    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Booking ID is returned\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response).to.have.property(\"bookingid\");\r",
              "    pm.expect(response.bookingid).to.be.a(\"number\");\r",
              "\r",
              "    pm.collectionVariables.set(\"bookingId\", response.bookingid);\r",
              "});\r",
              "\r",
              "pm.test(\"Created booking contains correct details\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response.booking.firstname).to.eql(\"Michael\");\r",
              "    pm.expect(response.booking.lastname).to.eql(\"Melo\");\r",
              "    pm.expect(response.booking.totalprice).to.eql(1500);\r",
              "    pm.expect(response.booking.depositpaid).to.eql(true);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
